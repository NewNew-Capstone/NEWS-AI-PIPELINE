                  "} else {",
                  "  pm.test('Spring video target returns success', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "  });",
                  "  if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
