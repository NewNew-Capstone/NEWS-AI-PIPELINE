# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5-20251001
EMOTION_KEYWORD_LLM_FILTER_ENABLED=true
EMOTION_KEYWORD_LLM_FILTER_MODEL=claude-haiku-4-5-20251001

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key
# YouTube 쿠키 파일 경로 (yt-dlp rate limit 우회용, 선택사항)
# 브라우저에서 유튜브 로그인 후 쿠키 export → 절대 경로 입력
# export 방법: Chrome 확장 "Get cookies.txt LOCALLY" 사용
# https://chromewebstore.google.com/detail/get-cookiestxt-locally/cclelndahbckbenkjhflpdbgdldlbecc
YOUTUBE_COOKIE_PATH=/your/path/to/www.youtube.com_cookies.txt

# Database
DATABASE_URL=your_database_url

# Redis
REDIS_URL=your_redis_url
